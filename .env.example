# Copy this file to .env and fill in your own Gemini API key.
ENDLESS_ADVENTURE_API_KEY=

# Optional: uncomment only if you want to override the client's defaults.
# ENDLESS_ADVENTURE_MODEL=
# ENDLESS_ADVENTURE_API_URL=

# Optional debug log: every story request, the model's reply, how the game parsed it, and full error messages,
# appended to this file (the API key is never written). Leave it unset to log nothing.
# ENDLESS_ADVENTURE_LLM_LOG=logs/llm.log

# Optional, only for the offline image generator (tools/imagegen); the game itself never uses them.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
